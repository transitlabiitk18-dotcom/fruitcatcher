# Firebase web app config (Firebase console > Project settings > Your apps > Web app).
# Leave these empty to run in LOCAL DEMO MODE: accounts and data stay in this browser only.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Shown on the "free trial ended" screen
VITE_ADMIN_CONTACT=admin@example.com
# Length of the free trial given at sign-up (days). Firestore rules allow at most 31.
VITE_TRIAL_DAYS=30
